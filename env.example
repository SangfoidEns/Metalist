# Frontend has NO secrets in the browser bundle.

# --- Auth API (server) ---
# Bot token from @BotFather — NEVER commit real token
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# HTTP port for local auth server
PORT=8787

# Restrict in production to your Mini App origin, e.g.:
# CORS_ORIGIN=https://your-username.github.io
CORS_ORIGIN=*

# Max age of initData auth_date (seconds). Default 24h.
INITDATA_MAX_AGE_SEC=86400

# Optional: public URL of this auth API (set same value in index.html meta ms-auth-api
# or localStorage key ms_auth_api / window.__MS_AUTH_API__)
# Example: https://auth.your-domain.com
# MS_AUTH_API_PUBLIC_URL=https://auth.your-domain.com
